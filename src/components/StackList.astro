---
import { stack } from "../data/stack";
---

<ul class="rows">
  {
    stack.map((group) => (
      <li class="row">
        <span class="label">{group.group}</span>
        <ul class="chips" data-chips>
          {group.items.map((item) => (
            <li class="chip">{item}</li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>

<script>
  const update = (el: HTMLElement) => {
    const max = el.scrollWidth - el.clientWidth;
    if (max <= 1) {
      delete el.dataset.fade;
      return;
    }
    const x = el.scrollLeft;
    el.dataset.fade = x <= 1 ? "end" : x >= max - 1 ? "start" : "both";
  };

  const all = () => document.querySelectorAll<HTMLElement>("[data-chips]");

  document.addEventListener("astro:page-load", () => {
    all().forEach((el) => {
      update(el);
      el.addEventListener("scroll", () => update(el), { passive: true });
    });
  });

  window.addEventListener("resize", () => all().forEach(update), { passive: true });
</script>

<style>
  .row {
    position: relative;
    display: flex;
    align-items: center;
    flex-wrap: nowrap;
    gap: 0.9rem;
    padding: 0.85rem 1.15rem;
  }

  .row + .row::before {
    content: "";
    position: absolute;
    top: 0;
    left: 1.15rem;
    right: 0;
    height: 1px;
    background: var(--separator);
  }

  .label {
    flex: none;
    font-size: var(--step-0);
    font-weight: 600;
    color: var(--muted);
  }

  .chips {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-wrap: nowrap;
    gap: 0.35rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .chips::-webkit-scrollbar { display: none; }

  .chips[data-fade="end"] {
    mask-image: linear-gradient(90deg, #000 0 88%, transparent 100%);
  }

  .chips[data-fade="start"] {
    mask-image: linear-gradient(90deg, transparent 0, #000 12% 100%);
  }

  .chips[data-fade="both"] {
    mask-image: linear-gradient(90deg, transparent 0, #000 12%, #000 88%, transparent 100%);
  }

  .chip:first-child { margin-inline-start: auto; }

  .chip { flex: none; }

  @media (max-width: 34rem) {
    .row { gap: 0.75rem; }
    .chip:first-child { margin-inline-start: 0; }
  }
</style>
