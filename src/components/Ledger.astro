---
interface Props { class?: string }
const { class: klass } = Astro.props;
---

<main class:list={["page", klass]}>
  <slot />
</main>

<style>
  .page {
    flex: 1;
    width: 100%;
    max-width: 52rem;
    margin-inline: auto;
    padding: clamp(1.5rem, 0.9rem + 2vw, 2.5rem) var(--gutter) 0;
    display: flex;
    flex-direction: column;
    gap: clamp(1.35rem, 0.9rem + 1.4vw, 2rem);
  }
</style>
