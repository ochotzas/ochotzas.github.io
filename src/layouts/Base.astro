---
import latinFont from "@fontsource-variable/plus-jakarta-sans/files/plus-jakarta-sans-latin-wght-normal.woff2?url";
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/motion.css";
import "../styles/code.css";
import { ClientRouter } from "astro:transitions";
import Chrome from "../components/Chrome.astro";
import avatar from "../assets/avatar.png";
import { site } from "../data/site";
import { profile } from "../data/profile";
import { links } from "../data/links";
import { work } from "../data/work";
import { stack } from "../data/stack";

interface Props {
  title?: string;
  description?: string;
  ogRoute?: string;
  type?: "website" | "article";
  published?: Date;
  updated?: Date;
  profilePage?: boolean;
  noindex?: boolean;
  keywords?: string[];
  wordCount?: number;
  breadcrumbs?: { name: string; path: string }[];
  bare?: boolean;
}

const {
  title,
  description = site.description,
  ogRoute = "home",
  type = "website",
  published,
  updated,
  profilePage = false,
  noindex = false,
  keywords = [],
  wordCount,
  breadcrumbs = [],
  bare = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${site.title}` : `${site.title} — ${profile.role}`;
const canonical = new URL(Astro.url.pathname, site.url);
const ogImage = new URL(`/og/${ogRoute}.png`, site.url);
const ogAlt = `${title ?? profile.name} — ${profile.role}`;

const person = {
  "@type": "Person",
  "@id": `${site.url}/#person`,
  name: profile.name,
  givenName: "Olger",
  familyName: "Chotza",
  jobTitle: profile.role,
  description: profile.tagline,
  email: `mailto:${profile.email}`,
  url: site.url,
  image: new URL(avatar.src, site.url).href,
  address: { "@type": "PostalAddress", addressCountry: profile.countryCode },
  nationality: { "@type": "Country", name: profile.country },
  knowsLanguage: ["en", "el", "sq"],
  knowsAbout: stack.flatMap((group) => group.items),
  hasOccupation: {
    "@type": "Occupation",
    name: profile.role,
    occupationalCategory: "15-1252.00",
    skills: stack.flatMap((group) => group.items).join(", "),
  },
  sameAs: links.map((link) => link.href),
};

const graph: Record<string, unknown>[] = [
  person,
  {
    "@type": "WebSite",
    "@id": `${site.url}/#website`,
    url: site.url,
    name: site.title,
    description: site.description,
    inLanguage: "en",
    publisher: { "@id": `${site.url}/#person` },
    copyrightHolder: { "@id": `${site.url}/#person` },
  },
];

if (profilePage) {
  graph.push({
    "@type": "ProfilePage",
    "@id": `${site.url}/#profilepage`,
    url: site.url,
    name: pageTitle,
    description,
    isPartOf: { "@id": `${site.url}/#website` },
    mainEntity: { "@id": `${site.url}/#person` },
    about: { "@id": `${site.url}/#person` },
    primaryImageOfPage: ogImage.href,
    hasPart: work.map((item) => ({
      "@type": "SoftwareSourceCode",
      name: item.name,
      description: item.blurb,
      codeRepository: item.repo ?? undefined,
      url: item.href ?? item.repo ?? undefined,
      programmingLanguage: item.stack,
      dateCreated: String(item.year),
      author: { "@id": `${site.url}/#person` },
    })),
  });
}

if (type === "article" && published) {
  graph.push({
    "@type": "BlogPosting",
    "@id": `${canonical.href}#article`,
    headline: title,
    description,
    url: canonical.href,
    image: ogImage.href,
    datePublished: published.toISOString(),
    dateModified: (updated ?? published).toISOString(),
    author: { "@id": `${site.url}/#person` },
    publisher: { "@id": `${site.url}/#person` },
    isPartOf: { "@id": `${site.url}/#website` },
    mainEntityOfPage: canonical.href,
    inLanguage: "en",
    ...(keywords.length ? { keywords: keywords.join(", ") } : {}),
    ...(wordCount ? { wordCount } : {}),
  });
}

if (breadcrumbs.length) {
  graph.push({
    "@type": "BreadcrumbList",
    "@id": `${canonical.href}#breadcrumb`,
    itemListElement: breadcrumbs.map((crumb, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: crumb.name,
      item: new URL(crumb.path, site.url).href,
    })),
  });
}

const jsonLd = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });
const robots = noindex
  ? "noindex, follow"
  : "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1";
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <link rel="canonical" href={canonical} />

    <link rel="preload" href={latinFont} as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {type === "article" && <meta property="article:author" content={profile.name} />}
    {keywords.map((tag) => <meta property="article:tag" content={tag} />)}

    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="alternate" type="text/markdown" title="llms.txt" href="/llms.txt" />
    <link rel="me" href={`mailto:${profile.email}`} />
    <link rel="author" href={site.url} />

    <meta name="theme-color" content="#f2f2f4" />
    <meta name="apple-mobile-web-app-title" content={site.title} />
    <meta name="format-detection" content="telephone=no" />

    <ClientRouter />

    <script type="application/ld+json" is:inline set:html={jsonLd} />

    <script is:inline>
      (() => {
        const apply = () => {
          const stored = localStorage.getItem("theme");
          const root = document.documentElement;
          if (stored === "light" || stored === "dark") {
            root.dataset.theme = stored;
          } else {
            delete root.dataset.theme;
          }
          const dark =
            root.dataset.theme === "dark" ||
            (!root.dataset.theme && window.matchMedia("(prefers-color-scheme: dark)").matches);
          document
            .querySelector('meta[name="theme-color"]:not([media])')
            ?.setAttribute("content", dark ? "#000000" : "#f2f2f4");
        };
        apply();
        document.addEventListener("astro:after-swap", apply);

        const rank = (pathname) => {
          const p = pathname.replace(/index\.html$/, "").replace(/(.)\/+$/, "$1") || "/";
          if (p === "/contact") return 3;
          if (p.startsWith("/notes/")) return 2;
          if (p === "/notes") return 1;
          return 0;
        };

        document.addEventListener("astro:before-preparation", (event) => {
          if (event.sourceElement?.closest?.("[data-back]")) {
            event.direction = "back";
            return;
          }
          if (!event.sourceElement) return;
          const from = rank(event.from.pathname);
          const to = rank(event.to.pathname);
          if (to !== from) event.direction = to < from ? "back" : "forward";
        });

        const samePath = (a, b) =>
          a.replace(/index\.html$/, "").replace(/\/+$/, "") ===
          b.replace(/index\.html$/, "").replace(/\/+$/, "");

        document.addEventListener(
          "click",
          (event) => {
            if (event.defaultPrevented || event.button !== 0) return;
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
            const link = event.target.closest?.("a[href]");
            if (!link || link.target === "_blank" || link.hasAttribute("download")) return;
            const url = new URL(link.href, location.href);
            if (url.origin !== location.origin) return;
            if (!samePath(url.pathname, location.pathname)) return;

            event.preventDefault();
            if (!url.hash) {
              window.scrollTo({ top: 0, behavior: "smooth" });
              return;
            }
            const target = document.querySelector(url.hash);
            if (!target) return;
            target.scrollIntoView({ behavior: "smooth", block: "start" });
            history.replaceState(history.state, "", url.hash);
          },
          true,
        );
      })();
    </script>

    {
      site.cloudflareToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={`{"token": "${site.cloudflareToken}"}`}
        />
      )
    }
  </head>
  <body>
    {!bare && <Chrome />}
    <slot />
  </body>
</html>
